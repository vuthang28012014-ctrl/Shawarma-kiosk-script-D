local function GetCFrame(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj.CFrame end
    if obj:IsA("Model") then
        local primary = obj.PrimaryPart
        if primary then return primary.CFrame end
        for _, child in pairs(obj:GetDescendants()) do
            if child:IsA("BasePart") then return child.CFrame end
        end
    end
    return nil
end

local function TeleportTo(target)
    if not target then
        Window:Notify({ title = "⚠️", content = "Target not found!", duration = 2 })
        return
    end
    local char = Player.Character
    if not char then
        Window:Notify({ title = "⚠️", content = "Character not found!", duration = 2 })
        return
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then
        Window:Notify({ title = "⚠️", content = "HumanoidRootPart not found!", duration = 2 })
        return
    end
    local cf = GetCFrame(target)
    if not cf then
        Window:Notify({ title = "⚠️", content = "Target has no CFrame!", duration = 2 })
        return
    end
    root.CFrame = cf + Vector3.new(0, 30, 0)
    Window:Notify({ title = "📍", content = "Teleported!", duration = 1.5 })
end

local function GetPart(pathFunc)
    local ok, result = pcall(pathFunc)
    if ok and result then return result end
    return nil
end

