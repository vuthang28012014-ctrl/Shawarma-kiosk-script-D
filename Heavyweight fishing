local function PressKey(key)
    pcall(function()
        VIM:SendKeyEvent(true, key, false, game)
        task.wait(0.05)
        VIM:SendKeyEvent(false, key, false, game)
    end)
end

local function GetSelectedSkillKeys()
    local map = {Z = Enum.KeyCode.Z, X = Enum.KeyCode.X, C = Enum.KeyCode.C, V = Enum.KeyCode.V}
    local selected = getgenv().SelectedSkills
    if type(selected) == "string" then
        selected = {selected}
    elseif type(selected) ~= "table" then
        selected = {"Z", "X", "C", "V"}
    end
    local keys = {}
    for _, s in ipairs(selected) do
        local k = map[s]
        if k then table.insert(keys, k) end
    end
    return keys
end

local function StartSkillLoop()
    if SkillRunning then return end
    SkillRunning = true
    task.spawn(function()
        local allKeys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
        local names = {"Z", "X", "C", "V"}
        while getgenv().MasterFarm and getgenv().AutoSkills do
            local fishing = MainGui:FindFirstChild("Fishing")
            if not fishing or not fishing.Visible then
                task.wait(0.5)
                continue
            end
            local toPress = GetSelectedSkillKeys()
            if getgenv().SmartSkills then
                local skillFrame = fishing:FindFirstChild("SkillButton")
                if skillFrame then
                    local frame = skillFrame:FindFirstChild("Frame")
                    if frame then
                        for i, key in ipairs(allKeys) do
                            local should = false
                            for _, k in ipairs(toPress) do
                                if k == key then should = true break end
                            end
                            if not should then continue end
                            local btn = frame:FindFirstChild(names[i])
                            if btn then
                                local cd = btn:FindFirstChild("CD")
                                if cd and cd:IsA("TextLabel") and not cd.Visible then
                                    PressKey(key)
                                    task.wait(0.15)
                                elseif not cd then
                                    PressKey(key)
                                    task.wait(0.15)
                                end
                            end
                        end
                    end
                else
                    for _, key in ipairs(toPress) do
                        PressKey(key)
                        task.wait(0.15)
                    end
                end
            else
                for _, key in ipairs(toPress) do
                    PressKey(key)
                    task.wait(0.15)
                end
            end
            task.wait(0.5)
        end
        SkillRunning = false
    end)
end

