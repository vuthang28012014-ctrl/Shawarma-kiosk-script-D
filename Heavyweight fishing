-- ===== FLY (smooth BodyVelocity) =====
local function StartFly()
    if FlyRunning then return end
    FlyRunning = true

    local char = Player.Character
    if not char then
        FlyRunning = false
        return
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then
        FlyRunning = false
        return
    end

    -- Tạo BodyVelocity
    flyVelocity = Instance.new("BodyVelocity")
    flyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    flyVelocity.Velocity = Vector3.new(0,0,0)
    flyVelocity.Parent = root

    -- Tạo BodyGyro để giữ hướng (có thể bỏ nếu không cần)
    flyGyro = Instance.new("BodyGyro")
    flyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    flyGyro.P = 10000
    flyGyro.CFrame = root.CFrame
    flyGyro.Parent = root

    -- Vòng lặp điều khiển bay
    task.spawn(function()
        while getgenv().FlyEnabled and char and root and flyVelocity and flyGyro do
            local speed = getgenv().FlySpeed or 50
            local move = Vector3.new(0,0,0)

            if UIS:IsKeyDown(Enum.KeyCode.W) then
                move = move + root.CFrame.LookVector
            end
            if UIS:IsKeyDown(Enum.KeyCode.S) then
                move = move - root.CFrame.LookVector
            end
            if UIS:IsKeyDown(Enum.KeyCode.A) then
                move = move - root.CFrame.RightVector
            end
            if UIS:IsKeyDown(Enum.KeyCode.D) then
                move = move + root.CFrame.RightVector
            end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then
                move = move + Vector3.new(0, 1, 0)
            end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
                move = move + Vector3.new(0, -1, 0)
            end

            if move.Magnitude > 0 then
                move = move.Unit * speed
            end

            flyVelocity.Velocity = move
            flyGyro.CFrame = root.CFrame

            task.wait()
        end
        -- Khi tắt fly, xóa BodyVelocity và BodyGyro
        if flyVelocity then flyVelocity:Destroy(); flyVelocity = nil end
        if flyGyro then flyGyro:Destroy(); flyGyro = nil end
        FlyRunning = false
    end)
end

-- ===== INFINITE JUMP (liên tục như Infinite Yield) =====
local infiniteJumpRunning = false
local infiniteJumpThread = nil
local function ToggleInfiniteJump(state)
    if state then
        if infiniteJumpRunning then return end
        infiniteJumpRunning = true
        infiniteJumpThread = task.spawn(function()
            while getgenv().InfiniteJump do
                -- Kiểm tra Space được nhấn
                if UIS:IsKeyDown(Enum.KeyCode.Space) then
                    local char = Player.Character
                    if char then
                        local humanoid = char:FindFirstChild("Humanoid")
                        if humanoid then
                            humanoid.Jump = true
                        end
                    end
                end
                task.wait()  -- mỗi frame
            end
            infiniteJumpRunning = false
        end)
    else
        if infiniteJumpThread then
            task.cancel(infiniteJumpThread)
            infiniteJumpThread = nil
        end
        infiniteJumpRunning = false
    end
end

-- ===== FULLBRIGHT =====
local fullbrightConnection = nil
local function ToggleFullbright(state)
    if state then
        if originalBrightness == nil then
            originalBrightness = Lighting.Brightness
            originalAmbient = Lighting.Ambient
            originalOutdoorAmbient = Lighting.OutdoorAmbient
        end
        if fullbrightConnection then fullbrightConnection:Disconnect() end
        fullbrightConnection = RunService.Heartbeat:Connect(function()
            Lighting.Brightness = 10
            Lighting.Ambient = Color3.new(1,1,1)
            Lighting.OutdoorAmbient = Color3.new(1,1,1)
        end)
    else
        if fullbrightConnection then fullbrightConnection:Disconnect(); fullbrightConnection = nil end
        Lighting.Brightness = originalBrightness or 2
        Lighting.Ambient = originalAmbient or Color3.new(0,0,0)
        Lighting.OutdoorAmbient = originalOutdoorAmbient or Color3.new(0,0,0)
    end
end

-- ===== NOCLIP =====
local originalCollisionStates = {}
local noClipConnection = nil
local function ToggleNoClip(state)
    local char = Player.Character
    if not char then return end

    if state then
        originalCollisionStates = {}
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                originalCollisionStates[part] = part.CanCollide
                part.CanCollide = false
            end
        end
        if noClipConnection then noClipConnection:Disconnect() end
        noClipConnection = RunService.Heartbeat:Connect(function()
            if not getgenv().NoClip then return end
            local c = Player.Character
            if c then
                for _, part in pairs(c:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if noClipConnection then noClipConnection:Disconnect(); noClipConnection = nil end
        local c = Player.Character
        if c then
            for _, part in pairs(c:GetDescendants()) do
                if part:IsA("BasePart") then
                    local orig = originalCollisionStates[part]
                    part.CanCollide = (orig == nil and true) or orig
                end
            end
        end
        originalCollisionStates = {}
    end
end

