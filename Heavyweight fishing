    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then FlyRunning = false; return end
    flyVelocity = Instance.new("BodyVelocity")
    flyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    flyVelocity.Velocity = Vector3.new(0,0,0)
    flyVelocity.Parent = root
    flyGyro = Instance.new("BodyGyro")
    flyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    flyGyro.P = 10000
    flyGyro.CFrame = root.CFrame
    flyGyro.Parent = root
    task.spawn(function()
        while getgenv().FlyEnabled and char and root and flyVelocity and flyGyro do
            local speed = getgenv().FlySpeed or 50
            local move = Vector3.new(0,0,0)
            if UIS:IsKeyDown(Enum.KeyCode.W) then move = move + root.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then move = move - root.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then move = move - root.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then move = move + root.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then move = move + Vector3.new(0,-1,0) end
            if move.Magnitude > 0 then
                move = move.Unit * speed
            end
            flyVelocity.Velocity = move
            flyGyro.CFrame = root.CFrame
            task.wait()
        end
        if flyVelocity then flyVelocity:Destroy(); flyVelocity = nil end
        if flyGyro then flyGyro:Destroy(); flyGyro = nil end
        FlyRunning = false
    end)
end

