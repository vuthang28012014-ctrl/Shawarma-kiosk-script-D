local function GetPlayerData()
    return Data:FindFirstChild(tostring(Player.UserId))
end

local function GetInventoryUsage()
    local p = GetPlayerData()
    if not p then return 0 end
    local c = #p.Inventory:GetChildren()
    for _, s in pairs(p.Hotbar:GetChildren()) do
        if s.Name ~= "1" and s.Name ~= "2" and s.Name ~= "3" then
            c = c + s.Quantity.Value
        end
    end
    return c
end

local function GetInventoryLimit()
    local p = GetPlayerData()
    if not p then return 999 end
    local l = p:FindFirstChild("InventoryLimit")
    return l and l.Value or 999
end

local function IsInventoryFull()
    return GetInventoryUsage() >= GetInventoryLimit()
end

local function CountFish()
    local p = GetPlayerData()
    if not p then return 0 end
    local total = 0
    local inv = p:FindFirstChild("Inventory")
    if not inv then return 0 end
    for _, item in pairs(inv:GetChildren()) do
        local name = item.Name
        local info = GameService.DestringFish(name)
        if info and info.FishName then
            total = total + item.Value
        else
            local clean = string.split(name, "| Favorite")[1]
            local mod = Info.Inventory:FindFirstChild(clean)
            if mod then
                local ok, m = pcall(require, mod)
                if ok and type(m) == "table" and (m.Type == "Fish" or m.Category == "Fish") then
                    total = total + item.Value
                end
            end
        end
    end
    return total
end

local function GetFishBreakdown()
    local p = GetPlayerData()
    if not p then return {} end
    local list = {}
    local inv = p:FindFirstChild("Inventory")
    if not inv then return {} end
    for _, item in pairs(inv:GetChildren()) do
        local name = item.Name
        local info = GameService.DestringFish(name)
        if info and info.FishName then
            table.insert(list, {Name = info.FishName, Count = item.Value})
        else
            local clean = string.split(name, "| Favorite")[1]
            local mod = Info.Inventory:FindFirstChild(clean)
            if mod then
                local ok, m = pcall(require, mod)
                if ok and type(m) == "table" and (m.Type == "Fish" or m.Category == "Fish") then
                    table.insert(list, {Name = clean, Count = item.Value})
                end
            end
        end
    end
    table.sort(list, function(a,b) return a.Count > b.Count end)
    return list
end

