local function GetPlayerData()
    return Data:FindFirstChild(tostring(Player.UserId))
end

local function GetInventoryUsage()
    local playerData = GetPlayerData()
    if not playerData then return 0 end
    local count = #playerData.Inventory:GetChildren()
    for _, slot in pairs(playerData.Hotbar:GetChildren()) do
        if slot.Name ~= "1" and slot.Name ~= "2" and slot.Name ~= "3" then
            count = count + slot.Quantity.Value
        end
    end
    return count
end

local function GetInventoryLimit()
    local playerData = GetPlayerData()
    if not playerData then return 999 end
    local limit = playerData:FindFirstChild("InventoryLimit")
    return limit and limit.Value or 999
end

local function IsInventoryFull()
    return GetInventoryUsage() >= GetInventoryLimit()
end

local function CountFish()
    local playerData = GetPlayerData()
    if not playerData then return 0 end
    local total = 0
    local inv = playerData:FindFirstChild("Inventory")
    if not inv then return 0 end
    for _, item in pairs(inv:GetChildren()) do
        local name = item.Name
        local fishInfo = GameService.DestringFish(name)
        if fishInfo and fishInfo.FishName then
            total = total + item.Value
        else
            local clean = string.split(name, "| Favorite")[1]
            local module = Info.Inventory:FindFirstChild(clean)
            if module then
                local ok, mod = pcall(require, module)
                if ok and type(mod) == "table" and (mod.Type == "Fish" or mod.Category == "Fish") then
                    total = total + item.Value
                end
            end
        end
    end
    return total
end

local function GetFishBreakdown()
    local playerData = GetPlayerData()
    if not playerData then return {} end
    local list = {}
    local inv = playerData:FindFirstChild("Inventory")
    if not inv then return {} end
    for _, item in pairs(inv:GetChildren()) do
        local name = item.Name
        local fishInfo = GameService.DestringFish(name)
        if fishInfo and fishInfo.FishName then
            table.insert(list, {Name = fishInfo.FishName, Count = item.Value})
        else
            local clean = string.split(name, "| Favorite")[1]
            local module = Info.Inventory:FindFirstChild(clean)
            if module then
                local ok, mod = pcall(require, module)
                if ok and type(mod) == "table" and (mod.Type == "Fish" or mod.Category == "Fish") then
                    table.insert(list, {Name = clean, Count = item.Value})
                end
            end
        end
    end
    table.sort(list, function(a,b) return a.Count > b.Count end)
    return list
end

local function GetLevel()
    local playerData = GetPlayerData()
    if not playerData then return 0 end
    local lvl = playerData:FindFirstChild("Level")
    if lvl then
        local val = lvl:FindFirstChild("Level")
        return val and val.Value or 0
    end
    return 0
end

local function GetCoins()
    local playerData = GetPlayerData()
    if not playerData then return 0 end
    local coins = playerData:FindFirstChild("Coins")
    return coins and coins.Value or 0
end

