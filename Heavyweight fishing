local function HookFishingMinigame()
    local FishingMinigame = Events:FindFirstChild("FishingMinigame")
    if not FishingMinigame then
        task.wait(1)
        return HookFishingMinigame()
    end

    local connections = getconnections(FishingMinigame.OnClientEvent)
    local originalCallbacks = {}
    if connections and #connections > 0 then
        for _, conn in ipairs(connections) do
            table.insert(originalCallbacks, conn.Function)
            conn:Disconnect()
        end
    end

    FishingMinigame.OnClientEvent:Connect(function(fishData, rodData, uuid)
        if type(rodData) == "table" then
            rodData.Power = 1000
            rodData.Luck = 1000
        end
        for _, cb in ipairs(originalCallbacks) do
            pcall(cb, fishData, rodData, uuid)
        end
    end)
end

spawn(function()
    task.wait(0.5)
    HookFishingMinigame()
end)

