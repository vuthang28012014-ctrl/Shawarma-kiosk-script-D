local function ClickButton(button)
    if not button then return end
    local success = pcall(function()
        local conns = getconnections(button.MouseButton1Click)
        for _, conn in pairs(conns) do
            conn:Fire()
        end
    end)
    if success then return end
    pcall(function()
        local pos = button.AbsolutePosition
        local size = button.AbsoluteSize
        local x = pos.X + size.X / 2
        local y = pos.Y + size.Y / 2
        local mouse = Player:GetMouse()
        VIM:SendMouseButtonEvent(x, y, 0, true, mouse, 1)
        task.wait(0.02)
        VIM:SendMouseButtonEvent(x, y, 0, false, mouse, 1)
    end)
end

local function PressKey(key)
    pcall(function()
        VIM:SendKeyEvent(true, key, false, game)
        task.wait(0.05)
        VIM:SendKeyEvent(false, key, false, game)
    end)
end

local function GetSelectedSkillKeys()
    local map = {Z = Enum.KeyCode.Z, X = Enum.KeyCode.X, C = Enum.KeyCode.C, V = Enum.KeyCode.V}
    local selected = getgenv().SelectedSkills
    if type(selected) == "string" then selected = {selected}
    elseif type(selected) ~= "table" then selected = {"Z", "X", "C", "V"} end
    local keys = {}
    for _, s in ipairs(selected) do
        local k = map[s]
        if k then table.insert(keys, k) end
    end
    return keys
end

local function StartSkillLoop()
    if SkillRunning then return end
    SkillRunning = true
    task.spawn(function()
        local allKeys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
        local keyNames = {"Z", "X", "C", "V"}

        while getgenv().MasterFarm and getgenv().AutoSkills do
            local fishing = MainGui:FindFirstChild("Fishing")
            if not fishing or not fishing.Visible then
                task.wait(0.5)
                continue
            end

            local trashCan = fishing:FindFirstChild("TrashCan")
            local skillBtn = nil
            local skillType = nil
            if trashCan then
                for _, child in pairs(trashCan:GetChildren()) do
                    if child.Name == "Slam" then
                        skillBtn = child:FindFirstChild("Button")
                        skillType = "Slam"
                        break
                    elseif child.Name == "Charge" then
                        skillBtn = child:FindFirstChild("Button")
                        skillType = "Charge"
                        break
                    end
                end
            end

            if skillBtn then
                local success = false
                if skillType == "Slam" then
                    task.wait(SLAM_CLICK_TIME)
                    success = true
                else
                    task.wait(0.5)
                    success = true
                end

                if success and skillBtn then
                    ClickButton(skillBtn)
                    task.wait(0.3)
                end
            end

            if not skillBtn then
                local toPress = GetSelectedSkillKeys()
                if getgenv().SmartSkills then
                    local skillFrame = fishing:FindFirstChild("SkillButton")
                    if skillFrame then
                        local frame = skillFrame:FindFirstChild("Frame")
                        if frame then
                            for i, key in ipairs(allKeys) do
                                local shouldPress = false
                                for _, k in ipairs(toPress) do
                                    if k == key then
                                        shouldPress = true
                                        break
                                    end
                                end
                                if not shouldPress then continue end

                                local btn = frame:FindFirstChild(keyNames[i])
                                if btn then
                                    local cd = btn:FindFirstChild("CD")
                                    if cd and cd:IsA("TextLabel") then
                                        if not cd.Visible then
                                            PressKey(key)
                                            task.wait(0.15)
                                        end
                                    else
                                        PressKey(key)
                                        task.wait(0.15)
                                    end
                                end
                            end
                        end
                    else
                        for _, key in ipairs(toPress) do
                            PressKey(key)
                            task.wait(0.15)
                        end
                    end
                else
                    for _, key in ipairs(toPress) do
                        PressKey(key)
                        task.wait(0.15)
                    end
                end
            end

            task.wait(0.3)
        end
        SkillRunning = false
    end)
end

