local function StartAntiAFKLoop()
    if AntiAFKRunning then return end
    AntiAFKRunning = true
    task.spawn(function()
        local lastMove = tick()
        while getgenv().MasterFarm and getgenv().AntiAFK do
            local char = Player.Character
            if char and char:GetAttribute("ReadyToAFK") == true then
                char:SetAttribute("ReadyToAFK", false)
            end
            if Player:GetAttribute("ReadyToAFK") == true then
                Player:SetAttribute("ReadyToAFK", false)
            end
            if tick() - lastMove > 600 then
                local mouse = Player:GetMouse()
                if mouse then
                    local x = mouse.X
                    VIM:SendMouseMovementEvent(x + 1, mouse.Y, 0, false)
                    task.wait(0.1)
                    VIM:SendMouseMovementEvent(x, mouse.Y, 0, false)
                end
                lastMove = tick()
            end
            task.wait(5)
        end
        AntiAFKRunning = false
    end)
end

