local function EquipFishingRod()
    local char = Player.Character
    if char and char:GetAttribute("Type") == "Fishing Rod" then return true end
    local p = GetPlayerData()
    if not p then return false end
    for i = 1, 10 do
        local slot = p.Hotbar:FindFirstChild(tostring(i))
        if slot then
            local name = slot.ValueName.Value
            if name == "Fishing rod" or string.find(name:lower(), "rod") then
                if name ~= "Fishing rod inventory" then
                    pcall(function() Events.ToggleHotbar:InvokeServer(tostring(i), nil) end)
                    task.wait(0.3)
                    if Player.Character and Player.Character:GetAttribute("Type") == "Fishing Rod" then return true end
                end
            end
        end
    end
    local inv = p.Inventory
    if not inv then return false end
    for _, child in pairs(inv:GetChildren()) do
        local raw = child.Name
        local clean = string.split(raw, "| Favorite")[1]
        if clean == "Fishing rod inventory" then continue end
        local mod = Info.Inventory:FindFirstChild(clean)
        if mod then
            local ok, m = pcall(require, mod)
            if ok and type(m) == "table" and (m.Type == "FishingRod" or string.find(clean:lower(), "rod")) then
                local slot1 = p.Hotbar:FindFirstChild("1")
                if slot1 and slot1.ValueName.Value ~= "" then
                    pcall(function() Events.MoveItems:FireServer("Hotbar", slot1.Name) end)
                    task.wait(0.15)
                end
                pcall(function() Events.MoveItems:FireServer("Inventory", clean, "1") end)
                task.wait(0.2)
                pcall(function() Events.ToggleHotbar:InvokeServer("1", nil) end)
                task.wait(0.3)
                if Player.Character and Player.Character:GetAttribute("Type") == "Fishing Rod" then return true end
            end
        end
    end
    return false
end

