-- 🐟 FISH COUNT HOOK
-- ==========================================
local fishCaughtEvent = Events:FindFirstChild("ReplicateFishCaught")
if fishCaughtEvent then
    fishCaughtEvent.OnClientEvent:Connect(function()
        FishCount = FishCount + 1
    end)
else
    for _, child in pairs(Events:GetChildren()) do
        if child:IsA("RemoteEvent") and string.find(child.Name, "Fish") then
            child.OnClientEvent:Connect(function()
                FishCount = FishCount + 1
            end)
            break
        end
    end
end
