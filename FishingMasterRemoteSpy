        if not log.RawBuffer then return end
        local bytes = {}
        for bs in log.RawHex:gmatch("%x%x") do bytes[#bytes+1] = tonumber(bs, 16) end
        local lines = {}
        lines[#lines+1] = "-- " .. log.PacketName .. " | " .. log.Direction .. " | " .. log.Size .. " bytes"
        lines[#lines+1] = "-- Script Path: " .. (log.ScriptPath or "unknown")
        lines[#lines+1] = ""
        lines[#lines+1] = 'local Event = game:GetService("ReplicatedStorage").Stardust.Packages.Packet.RemoteEvent'
        lines[#lines+1] = "Event:FireServer("
        lines[#lines+1] = "    (function(bytes) --[[Type: buffer]]"
        lines[#lines+1] = "        local b = buffer.create(#bytes)"
        lines[#lines+1] = "        for i = 1, #bytes do"
        lines[#lines+1] = "            buffer.writeu8(b, i - 1, bytes[i])"
        lines[#lines+1] = "        end"
        lines[#lines+1] = "        return b"
        lines[#lines+1] = "    end)(" .. bytesToLuaArray(bytes) .. ")"
        lines[#lines+1] = ")"
        if setclipboard then setclipboard(table.concat(lines, "\n")) end
    end)

    makeMiniBtn(actionHolder, "PATH", 156, ROW2_Y, 66, ROW_H, Color3.fromRGB(140, 100, 180), function()
        if setclipboard then
