-- ============================================================
-- 1. FIND REMOTEEVENT
-- ============================================================
local function findPacketRemote()
    local ok, stardust = pcall(function()
        return RS:WaitForChild("Stardust", 5)
    end)
    if not ok or not stardust then return nil end
    local pkg = stardust:FindFirstChild("Packages")
    if not pkg then return nil end
    local packet = pkg:FindFirstChild("Packet")
    if not packet then return nil end
    return packet:FindFirstChild("RemoteEvent")
end

local PacketRemote = findPacketRemote()
if not PacketRemote then
    warn("[Decoder] Không tìm thấy RemoteEvent")
    return
end

-- ============================================================
-- 2. REGISTRY
-- ============================================================
local IdToName = {}
local NameToId = {}

local function rebuildRegistry()
    table.clear(IdToName)
    table.clear(NameToId)
    for attrName, attrValue in pairs(PacketRemote:GetAttributes()) do
        if type(attrValue) == "number" then
            IdToName[attrValue]  = attrName
            NameToId[attrName]   = attrValue
        end
    end
end
rebuildRegistry()

PacketRemote.AttributeChanged:Connect(function(attrName)
    local newVal = PacketRemote:GetAttribute(attrName)
    if type(newVal) == "number" then
        local oldId = NameToId[attrName]
        if oldId then IdToName[oldId] = nil end
        IdToName[newVal]   = attrName
        NameToId[attrName] = newVal
    end
end)

-- ============================================================
-- 3. SCHEMA CAPTURE
-- ============================================================
local Schema = {}

local function registerPacket(packetObj)
    if type(packetObj) ~= "table" then return false end
    local id     = rawget(packetObj, "Id")
    local name   = rawget(packetObj, "Name")
    local reads  = rawget(packetObj, "Reads")
    local writes = rawget(packetObj, "Writes")
    if type(id) ~= "number" or type(name) ~= "string" or type(reads) ~= "table" then return false end

    local hasResp = rawget(packetObj, "ResponseReads") ~= nil
    local existing = Schema[id]
    if not existing or #reads > #(existing.reads or {}) then
        Schema[id] = {
            name        = name,
            reads       = reads,
            writes      = writes,
            hasResponse = hasResp,
        }
        return true
    end
    return false
end

local function scanGC()
    if not getgc then return 0 end
    local count = 0
    for _, mode in ipairs({true, false}) do
        pcall(function()
            for _, obj in pairs(getgc(mode)) do
                if type(obj) == "table" then
                    local name  = rawget(obj, "Name")
                    local reads = rawget(obj, "Reads")
                    if type(name) == "string" and type(reads) == "table" then
                        if registerPacket(obj) then count += 1 end
                    end
                end
            end
        end)
        if count > 0 then break end
    end
    return count
end

local PacketModule
local function hookConstructor()
    local ok = pcall(function() PacketModule = require(RS.Stardust.Packages.Packet) end)
    if not ok or type(PacketModule) ~= "table" then return false end
    local ok2, mt = pcall(getrawmetatable, PacketModule)
    if not ok2 or not mt or type(mt.__call) ~= "function" then return false end

    local oldCall = mt.__call
    pcall(setreadonly, mt, false)
    local hookOk = pcall(function()
        mt.__call = newcclosure(function(self, ...)
            local result = oldCall(self, ...)
            pcall(registerPacket, result)
            return result
        end)
    end)
    pcall(setreadonly, mt, true)
    return hookOk
end

local function scanUpvalues()
    if not PacketModule then return 0 end
    local dbg = debug and debug.getupvalue
    if not dbg then return 0 end
    local ok, mt = pcall(getrawmetatable, PacketModule)
    if not ok or not mt or type(mt.__call) ~= "function" then return 0 end
    local count = 0
    for i = 1, 40 do
        local ok2, name, val = pcall(dbg, mt.__call, i)
        if not ok2 or name == nil then break end
        if type(val) == "table" then
            for _, v in pairs(val) do
                if registerPacket(v) then count += 1 end
            end
        end
    end
    return count
end

local method1 = scanGC()
local method2 = hookConstructor()
local method3 = scanUpvalues()

local schemaCount0 = 0
for _ in pairs(Schema) do schemaCount0 += 1 end
print(string.format("[Decoder] Schema — GC: %d, Hook: %s, Upvalue: %d, Total: %d",
    method1, tostring(method2), method3, schemaCount0))

