local function showDetail(log)
    for _, c in ipairs(DetailScroll:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end

    addDetailRow("Packet Name", log.PacketName, Color3.fromRGB(120, 220, 180))
    addDetailRow("Direction", log.Direction, log.Direction == "IN" and Color3.fromRGB(100, 220, 120) or Color3.fromRGB(255, 180, 100))
    addDetailRow("Packet ID", "#" .. log.PacketId)
    addDetailRow("Size", log.Size .. " bytes")
    addDetailRow("Timestamp", log.Timestamp)
    addDetailRow("Response Slot", log.NextByte ~= nil and tostring(log.NextByte) or "N/A")
    addDetailRow("Script Path", log.ScriptPath or "unknown", Color3.fromRGB(200, 180, 255))

    if log.Decoded then
        addDetailRow("⭐ Decoded Args (" .. (log.ArgCount or 0) .. ")", log.Decoded, Color3.fromRGB(255, 220, 130))
    else
        addDetailRow("Decoded Args", "(no schema)", Color3.fromRGB(140, 140, 140))
    end

    addDetailRow("HEX", log.RawHex, Color3.fromRGB(180, 200, 220))
    addDetailRow("ASCII", log.RawAscii, Color3.fromRGB(140, 140, 160))
end

