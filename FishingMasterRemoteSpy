local function toHex(buf, from, to)
    from = from or 0
    to   = to   or buffer.len(buf)
    local p = {}
    for i = from, to - 1 do p[#p+1] = string.format("%02X", buffer.readu8(buf, i)) end
    return table.concat(p, " ")
end

local function toAscii(buf, from, to)
    from = from or 0
    to   = to   or buffer.len(buf)
    local s = ""
    for i = from, to - 1 do
        local b = buffer.readu8(buf, i)
        s = s .. (b >= 32 and b < 127 and string.char(b) or ".")
    end
    return s
end

local function safeReadU8(buf, offset)
    if offset >= buffer.len(buf) then return nil end
    return buffer.readu8(buf, offset)
end

local function toTimeStr()
    local t = os.date("*t")
    return string.format("%02d:%02d:%02d", t.hour, t.min, t.sec)
end

local function formatArg(v)
    local t = typeof(v)
    if t == "Instance" then return string.format("Instance(%s: %s)", v.ClassName, v.Name)
    elseif t == "CFrame" then local p = v.Position return string.format("CFrame(%.2f, %.2f, %.2f)", p.X, p.Y, p.Z)
    elseif t == "Vector3" then return string.format("Vector3(%.2f, %.2f, %.2f)", v.X, v.Y, v.Z)
    elseif t == "Vector2" then return string.format("Vector2(%.2f, %.2f)", v.X, v.Y)
    elseif t == "Color3" then return string.format("Color3(%d, %d, %d)", v.R*255, v.G*255, v.B*255)
    elseif t == "string" then
        local s = #v > 60 and v:sub(1,57).."..." or v
        return string.format("%q", s)
    elseif t == "number" then
        if math.floor(v) == v then return tostring(v) end
        return string.format("%.4f", v)
    elseif t == "boolean" then return tostring(v)
    elseif t == "table" then return "{table}"
    elseif t == "nil" then return "nil"
    else return tostring(v) end
end

local function valueToLua(v)
    local t = typeof(v)
    if t == "nil" then return "nil" end
    if t == "boolean" then return tostring(v) end
    if t == "number" then
        if math.floor(v) == v and math.abs(v) < 1e15 then return tostring(v) end
        return string.format("%.6f", v)
    end
    if t == "string" then
        local esc = v:gsub("\\","\\\\"):gsub("\"","\\\""):gsub("\n","\\n"):gsub("\r","\\r"):gsub("\t","\\t"):gsub("%z","\\0")
        return '"' .. esc .. '"'
    end
    if t == "Instance" then
        if not v.Parent then return 'nil --[[Instance('..v.ClassName..': '..v.Name..') đã xóa]]' end
        local ok, full = pcall(function() return v:GetFullName() end)
        if ok and full then return "game." .. full end
        return 'nil --[[Instance('..v.ClassName..': '..v.Name..')]]'
    end
    if t == "Vector3" then return string.format("Vector3.new(%.6f, %.6f, %.6f)", v.X, v.Y, v.Z) end
    if t == "Vector2" then return string.format("Vector2.new(%.6f, %.6f)", v.X, v.Y) end
    if t == "CFrame" then
        local x,y,z,R00,R01,R02,R10,R11,R12,R20,R21,R22 = v:GetComponents()
        return string.format("CFrame.new(%.6f,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f)",
            x,y,z,R00,R01,R02,R10,R11,R12,R20,R21,R22)
    end
    if t == "Color3" then return string.format("Color3.fromRGB(%d,%d,%d)", v.R*255, v.G*255, v.B*255) end
    if t == "UDim2" then return string.format("UDim2.new(%f,%d,%f,%d)", v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset) end
    if t == "UDim" then return string.format("UDim.new(%f,%d)", v.Scale, v.Offset) end
    if t == "Rect" then return string.format("Rect.new(%d,%d,%d,%d)", v.Min.X, v.Min.Y, v.Max.X, v.Max.Y) end
    if t == "BrickColor" then return string.format("BrickColor.new(%d)", v.Number) end
    if t == "EnumItem" then return string.format("Enum.%s.%s", tostring(v.EnumType), v.Name) end
    return "nil --[[unsupported: " .. t .. "]]"
end

local function bytesToLuaArray(bytes)
    local p = {}
    for i = 1, #bytes do p[#p+1] = tostring(bytes[i]) end
    return "{ " .. table.concat(p, ", ") .. " }"
end

-- ⭐ Analyze code (dùng cho nút ANALYZE)
local function buildAnalyzedCode(log)
    if not log.DecodedArgs or log.Direction ~= "OUT" then return nil end
    local lines = {}
    local argStr = {}
    for i, arg in ipairs(log.DecodedArgs) do
        argStr[#argStr+1] = i .. " => " .. valueToLua(arg)
    end
    lines[#lines+1] = "-- Decoded args: " .. table.concat(argStr, ", ")
    lines[#lines+1] = "-- Packet: " .. log.PacketName .. " (#" .. log.PacketId .. ") | Script: " .. (log.ScriptPath or "unknown")
    lines[#lines+1] = ""
    lines[#lines+1] = 'local Event = game:GetService("ReplicatedStorage").Stardust.Packages.Packet.RemoteEvent'
    lines[#lines+1] = "Event:FireServer("
    for i, arg in ipairs(log.DecodedArgs) do
        lines[#lines+1] = "    " .. valueToLua(arg) .. (i < #log.DecodedArgs and "," or "")
    end
    lines[#lines+1] = ")"
    return table.concat(lines, "\n")
end

-- ⭐ Encode args với schema.writes
local function encodeArgsWithSchema(packetId, args, origInstances)
    local schema = Schema[packetId]
    if not schema or not schema.writes then return nil, "No writes schema" end
    if not PacketTypes or not PacketTypes.Import or not PacketTypes.Writes or not PacketTypes.Export then
        return nil, "PacketTypes missing"
    end

    local ok, res = pcall(function()
        local state = {
            Buffer          = buffer.create(512),
            BufferLength    = 512,
            BufferOffset    = 0,
            Instances       = {},
            InstancesOffset = 0,
        }
        PacketTypes.Import(state)
        PacketTypes.Writes.NumberU8(packetId)

        for i, writeFn in ipairs(schema.writes) do
            writeFn(args[i])
        end

        local exported = PacketTypes.Export()
        local finalBuf
        if PacketTypes.Truncate then
            finalBuf = PacketTypes.Truncate()
        else
            local len = exported.BufferOffset or 0
            finalBuf = buffer.create(len)
            buffer.copy(finalBuf, 0, exported.Buffer, 0, len)
        end

        local instList = {}
        local io = exported.InstancesOffset or 0
        for i = 1, io do
            instList[i] = exported.Instances[i]
        end
        return { buffer = finalBuf, instances = instList }
    end)

    if ok and res then return res.buffer, res.instances end
    return nil, tostring(res)
end

-- ⭐ Parse decoded Lua code để lấy args
local function parseDecodedArgs(code)
    local startPos = code:find("FireServer%s*%(")
    if not startPos then return nil, "No FireServer call" end
    local openParen = code:find("%(", startPos)
    if not openParen then return nil, "No open paren" end
    local closeParen = code:match("()%s*%)%s*$")
    if not closeParen or closeParen <= openParen then return nil, "No close paren" end

    local argsStr = code:sub(openParen + 1, closeParen - 1)
    local loader, err = loadstring("return { " .. argsStr .. " }")
    if not loader then return nil, "Syntax: " .. tostring(err) end
    local ok, args = pcall(loader)
    if not ok then return nil, "Runtime: " .. tostring(args) end
    return args
end

-- ⭐ Parse encoded byte text
local function parseEncodedBytes(text)
    local bytes = {}
    for num in text:gmatch("%d+") do
        bytes[#bytes+1] = tonumber(num)
    end
    if #bytes == 0 then return nil, "No bytes found" end
    return bytes
end

-- ============================================================
-- 6. DECODE ARGS
-- ============================================================
local function decodeArgs(packetId, buf, instances)
    local schema = Schema[packetId]
    if not schema then return nil end
    if not PacketTypes or not PacketTypes.Import or not PacketTypes.Reads then return nil end

    local ok, result = pcall(function()
        local state = {
            Buffer          = buf,
            BufferLength    = buffer.len(buf),
            BufferOffset    = 0,
            Instances       = instances or {},
            InstancesOffset = 0,
        }
        PacketTypes.Import(state)
        PacketTypes.Reads.NumberU8()
        if schema.hasResponse then pcall(PacketTypes.Reads.NumberU8) end

        local args = {}
        for i, readFn in ipairs(schema.reads) do
            local ok2, val = pcall(readFn)
            if not ok2 then break end
            args[i] = val
        end
        return args
    end)

    if ok then return result end
    return nil
end

-- ============================================================
-- 7. PARSER
-- ============================================================
local function parseBuffer(buf, direction, instances, scriptPath)
    if type(buf) ~= "buffer" then return nil end
    local size = buffer.len(buf)
    if size == 0 then return nil end

    local packetId = safeReadU8(buf, 0)
    if not packetId then return nil end

    local packetName = IdToName[packetId] or ("UNKNOWN_" .. packetId)
    local nextByte   = safeReadU8(buf, 1)

    local rawClone = nil
    pcall(function()
        rawClone = buffer.create(size)
        buffer.copy(rawClone, 0, buf, 0, size)
    end)

    local instClone = nil
    if type(instances) == "table" then
        instClone = {}
        for i, v in ipairs(instances) do instClone[i] = v end
    end

    local log = {
        Direction   = direction,
        PacketId    = packetId,
        PacketName  = packetName,
        NextByte    = nextByte,
        RawHex      = toHex(buf, 0, size),
        RawAscii    = toAscii(buf, 0, size),
        Size        = size,
        Timestamp   = toTimeStr(),
        Time        = os.clock(),
        Decoded     = nil,
        DecodedArgs = nil,
        RawBuffer   = rawClone,
        Instances   = instClone,
        ScriptPath  = scriptPath or "unknown",
    }

    local args = decodeArgs(packetId, buf, instances)
    if args and #args > 0 then
        log.DecodedArgs = args
        local lines = {}
        for i, v in ipairs(args) do
            lines[#lines+1] = string.format("[%d] %s", i, formatArg(v))
        end
        log.Decoded = table.concat(lines, "\n")
        log.ArgCount = #args
    end

    return log
end

