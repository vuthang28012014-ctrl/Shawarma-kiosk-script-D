            local nb = buffer.create(buffer.len(log.RawBuffer))
            buffer.copy(nb, 0, log.RawBuffer, 0, buffer.len(log.RawBuffer))
            return nb
        end)
        if not ok or not clone then return end
        pcall(function()
            if log.Instances and #log.Instances > 0 then
                PacketRemote:FireServer(clone, log.Instances)
            else
                PacketRemote:FireServer(clone)
            end
        end)
    end)

