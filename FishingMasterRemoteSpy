-- Load modify panel
-- ============================================================
local function loadModifyPanel(log)
    ModifyState.CurrentLog = log
    ModifyState.CurrentArgs = log.DecodedArgs

    if log.DecodedArgs then
        local lines = {}
        lines[#lines+1] = "-- " .. log.PacketName .. " (#" .. log.PacketId .. ")"
        lines[#lines+1] = "-- Script: " .. (log.ScriptPath or "unknown")
        lines[#lines+1] = ""
        lines[#lines+1] = 'local Event = game:GetService("ReplicatedStorage").Stardust.Packages.Packet.RemoteEvent'
        lines[#lines+1] = "Event:FireServer("
        for i, arg in ipairs(log.DecodedArgs) do
            lines[#lines+1] = "    " .. valueToLua(arg) .. (i < #log.DecodedArgs and "," or "")
        end
        lines[#lines+1] = ")"
        DecodedBox.Text = table.concat(lines, "\n")
    else
        DecodedBox.Text = "-- No decoded args (packet chưa có schema)"
    end

    if log.RawHex then
        local bytes = {}
        for byteStr in log.RawHex:gmatch("%x%x") do
            bytes[#bytes+1] = tostring(tonumber(byteStr, 16))
        end
        EncodedBox.Text = "{ " .. table.concat(bytes, ", ") .. " }"
    else
        EncodedBox.Text = ""
    end
end

-- Change Form button: parse decoded → encode → update EncodedBox
ChangeFormBtn.MouseButton1Click:Connect(function()
    local log = ModifyState.CurrentLog
    if not log then
        warn("[Modify] Chưa chọn packet nào")
        return
    end

    local args, err = parseDecodedArgs(DecodedBox.Text)
    if not args then
        warn("[Modify] Parse error:", err)
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Modify Error", Text = tostring(err), Duration = 2,
            })
        end)
        return
    end

    local buf, instList = encodeArgsWithSchema(log.PacketId, args, log.Instances)
    if not buf then
        warn("[Modify] Encode failed:", instList)
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Encode Error", Text = tostring(instList), Duration = 2,
            })
        end)
        return
    end

    local bytes = {}
    for i = 0, buffer.len(buf) - 1 do
        bytes[#bytes+1] = tostring(buffer.readu8(buf, i))
    end
    EncodedBox.Text = "{ " .. table.concat(bytes, ", ") .. " }"
    ModifyState.CurrentArgs = args

    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Modify Remote",
            Text = "Encoded " .. #bytes .. " bytes từ " .. #args .. " args",
            Duration = 2,
        })
    end)
end)

-- Play Encoded button
PlayEncodedBtn.MouseButton1Click:Connect(function()
    local log = ModifyState.CurrentLog
    if not log then
        warn("[Modify] Chưa chọn packet nào")
        return
    end

    local bytes, err = parseEncodedBytes(EncodedBox.Text)
    if not bytes then
        warn("[Modify] Parse error:", err)
        return
    end

    local buf = buffer.create(#bytes)
    for i, b in ipairs(bytes) do
        buffer.writeu8(buf, i - 1, b)
    end

    local ok, err2 = pcall(function()
        if log.Instances and #log.Instances > 0 then
            PacketRemote:FireServer(buf, log.Instances)
        else
            PacketRemote:FireServer(buf)
        end
    end)

    if ok then
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Play Encoded",
                Text = "Fired " .. log.PacketName .. " (" .. #bytes .. "b)",
                Duration = 2,
            })
        end)
    else
        warn("[Modify] Fire error:", err2)
    end
end)

