-- 10. IGNORE / BLOCK / FILTER
-- ============================================================
local function shouldIgnore(n) return State.IgnoreList[n] == true end
local function isBlocked(n) return State.BlockList[n] == true end

local function matchesFilter(log)
    if shouldIgnore(log.PacketName) then return false end
    if State.Filter == "" then return true end
    local f = State.Filter:lower()
    if string.find(log.PacketName:lower(), f, 1, true) then return true end
    if log.Decoded and string.find(log.Decoded:lower(), f, 1, true) then return true end
    if string.find(log.RawHex:lower(), f, 1, true) then return true end
    if log.ScriptPath and string.find(log.ScriptPath:lower(), f, 1, true) then return true end
    return false
end

local function refreshLogVisuals()
    for _, entry in ipairs(Scroll:GetChildren()) do
        if entry:IsA("Frame") and entry.Name == "LogEntry" then
            local logRef = entry:GetAttribute("LogIndex")
            if logRef then
                local log = State.Logs[logRef]
                if log then entry.Visible = matchesFilter(log) end
            end
        end
    end
end

