-- 13. HOOKS
-- ============================================================
local LogQueue = {}

local function handleParsedLog(log)
    if not State.Enabled or not log then return end
    if log.Direction == "IN" then State.StatIN += 1 else State.StatOUT += 1 end
    if #LogQueue < 5000 then table.insert(LogQueue, log) end
end

local function getCaller()
    if getcallingscript then
        local ok, s = pcall(getcallingscript)
        if ok and s then return s:GetFullName() end
    end
    if debug and debug.info then
        for lvl = 2, 8 do
            local ok, s = pcall(function() return debug.info(lvl, "s") end)
            if ok and s and type(s) == "Instance" then return s:GetFullName() end
        end
    end
    return "unknown"
end

pcall(function()
    PacketRemote.OnClientEvent:Connect(function(buf, instances)
        if type(buf) == "buffer" then
            handleParsedLog(parseBuffer(buf, "IN", instances, "server (OnClientEvent)"))
        end
    end)
end)

pcall(function()
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" and self == PacketRemote and State.Enabled then
            local args = { ... }
            local buf = args[1]
            local instances = args[2]
            if type(buf) == "buffer" then
                local caller = getCaller()
                local log = parseBuffer(buf, "OUT", instances, caller)
                if log then
                    if isBlocked(log.PacketName) then return end
                    handleParsedLog(log)
                end
            end
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
end)

task.spawn(function()
    while task.wait(0.1) do
        if not ScreenGui.Parent then break end
        if #LogQueue == 0 then continue end
        local batch = LogQueue
        LogQueue = {}
        for _, log in ipairs(batch) do pcall(pushLog, log) end
    end
end)

