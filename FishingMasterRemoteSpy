-- 12. PUSH LOG
-- ============================================================
pushLog = function(log)
    table.insert(State.Logs, log)
    while #State.Logs > State.MaxLogs do table.remove(State.Logs, 1) end

    if #State.Logs >= State.MaxLogs then
        for _, c in ipairs(Scroll:GetChildren()) do
            if c:IsA("Frame") and c.Name == "LogEntry" then c:Destroy() end
        end
        for i, l in ipairs(State.Logs) do
            local e = createLogEntry(l, i)
            e.Visible = matchesFilter(l)
        end
    else
        local entry = createLogEntry(log, #State.Logs)
        entry.Visible = matchesFilter(log)
    end

    if State.AutoScroll then
        task.defer(function() Scroll.CanvasPosition = Vector2.new(0, math.huge) end)
    end
end

