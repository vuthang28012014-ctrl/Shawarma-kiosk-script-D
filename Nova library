function Nova:Popup(o)
	o = o or {}
	local backdrop = create("Frame", {
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 50,
		Parent = ScreenGui,
	})
	tween(backdrop, { BackgroundTransparency = 0.5 }, 0.15)

	local card = create("Frame", {
		BackgroundColor3 = Theme.Surface,
		Size = UDim2.fromOffset(340, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.fromScale(0.5, 0.45),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 51,
		Parent = backdrop,
	}, { corner(10), stroke(Theme.Stroke, 1), padding(18) })

	create("UIListLayout", { Padding = UDim.new(0, 10), Parent = card })

	create("TextLabel", {
		Text = o.title or "Popup", Font = Theme.FontBold, TextSize = 16, TextColor3 = Theme.Text,
		BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 1, Parent = card,
	})
	if o.subtitle then
		create("TextLabel", {
			Text = o.subtitle, Font = Theme.Font, TextSize = 12, TextColor3 = Theme.SubText,
			BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, 0, 0, 16), LayoutOrder = 2, Parent = card,
		})
	end
	if o.content then
		create("TextLabel", {
			Text = o.content, Font = Theme.Font, TextSize = 13, TextColor3 = Theme.SubText,
			BackgroundTransparency = 1, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
			AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), LayoutOrder = 3, Parent = card,
		})
	end

	local function close()
		tween(backdrop, { BackgroundTransparency = 1 }, 0.15)
		task.delay(0.16, function() backdrop:Destroy() end)
	end

	local options = o.options or { { text = "OK", style = "primary" } }
	local btnRow = create("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 4, Parent = card,
	}, { create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, Padding = UDim.new(0, 8),
	}) })

	for _, opt in ipairs(options) do
		local bg = Theme.SurfaceAlt
		if opt.style == "primary" then bg = Theme.Accent elseif opt.style == "danger" then bg = Theme.Danger end
		local b = create("TextButton", {
			Text = opt.text or "OK", Font = Theme.FontBold, TextSize = 13, TextColor3 = Theme.Text,
			BackgroundColor3 = bg, Size = UDim2.fromOffset(90, 34), Parent = btnRow,
		}, { corner(6) })
		b.MouseButton1Click:Connect(function()
			if opt.callback then task.spawn(opt.callback) end
			if o.dismissable ~= false then close() end
		end)
	end

	if o.dismissable ~= false then
		backdrop.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				local pos = card.AbsolutePosition
				local size = card.AbsoluteSize
				local mouse = UserInputService:GetMouseLocation()
				if mouse.X < pos.X or mouse.X > pos.X + size.X or mouse.Y < pos.Y or mouse.Y > pos.Y + size.Y then
					close()
				end
			end
		end)
	end

	return { Close = close }
end

