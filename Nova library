local function resolveIcon(icon)
	if typeof(icon) == "number" then
		return "rbxassetid://" .. tostring(icon)
	elseif typeof(icon) == "string" and Nova.Icons[icon] then
		return "rbxassetid://" .. tostring(Nova.Icons[icon])
	end
	return nil
end

--============================================================
-- CONFIG SAVING
--============================================================

local function configPath(folder, file)
	local dir = folder and ("Nova/" .. folder) or "Nova"
	if not isfolder("Nova") then makefolder("Nova") end
	if folder and not isfolder(dir) then makefolder(dir) end
	return dir .. "/" .. (file or "config") .. ".json"
end

local function saveConfig(folder, file)
	local ok, encoded = pcall(HttpService.JSONEncode, HttpService, Nova.Flags)
	if ok then
		pcall(writefile, configPath(folder, file), encoded)
	end
end

local function loadConfig(folder, file)
	local path = configPath(folder, file)
	if isfile and isfile(path) then
		local ok, data = pcall(readfile, path)
		if ok then
			local ok2, decoded = pcall(HttpService.JSONDecode, HttpService, data)
			if ok2 then
				return decoded
			end
		end
	end
	return {}
end

