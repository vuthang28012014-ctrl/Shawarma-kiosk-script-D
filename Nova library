	--========================================================
	function Window:CreateTab(tabConfig)
		tabConfig = tabConfig or {}
		local name = tabConfig.Name or tabConfig.name or "Tab"

		local TabButton = create("TextButton", {
			Text = "   " .. name, Font = Theme.Font, TextSize = 13, TextColor3 = Theme.SubText,
			TextXAlignment = Enum.TextXAlignment.Left, BackgroundColor3 = Theme.Surface, BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 32), Parent = Window._TabList,
		}, { corner(6) })

		local Page = create("ScrollingFrame", {
			Name = name, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
			ScrollBarThickness = 3, CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false, Parent = Window._Content,
		}, { padding(14), create("UIListLayout", { Padding = UDim.new(0, 8) }) })

		local Tab = { _Page = Page }

		local function selectTab()
			for _, btn in pairs(Window._TabButtons) do
				tween(btn, { BackgroundTransparency = 1, TextColor3 = Theme.SubText }, 0.12)
			end
			for _, child in ipairs(Window._Content:GetChildren()) do
				if child:IsA("ScrollingFrame") then child.Visible = false end
			end
			tween(TabButton, { BackgroundTransparency = 0, TextColor3 = Theme.Text }, 0.12)
			Page.Visible = true
		end

		TabButton.MouseButton1Click:Connect(selectTab)
		table.insert(Window._TabButtons, TabButton)
		if #Window._TabButtons == 1 then selectTab() end

		local function baseRow(height)
			return create("Frame", { BackgroundColor3 = Theme.Surface, Size = UDim2.new(1, 0, 0, height or 40), Parent = Page },
				{ corner(8), stroke(Theme.Stroke, 1) })
		end

		local function registerFlag(flag, value)
			if flag then Nova.Flags[flag] = value end
		end

		function Tab:CreateSection(text)
			local row = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24), Parent = Page })
			create("TextLabel", {
				Text = text or "", Font = Theme.FontBold, TextSize = 12, TextColor3 = Theme.SubText,
				BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
				Size = UDim2.new(1, 0, 1, 0), Parent = row,
			})
			return { Instance = row }
		end

		function Tab:CreateParagraph(o)
			o = o or {}
			local row = baseRow(0)
			row.AutomaticSize = Enum.AutomaticSize.Y
			create("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), Parent = row })
			create("UIListLayout", { Padding = UDim.new(0, 4), Parent = row })
			create("TextLabel", {
				Text = o.Title or "", Font = Theme.FontBold, TextSize = 13, TextColor3 = Theme.Text,
				BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
				AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), Parent = row,
			})
			create("TextLabel", {
				Text = o.Content or "", Font = Theme.Font, TextSize = 12, TextColor3 = Theme.SubText, TextWrapped = true,
				BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
				AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), Parent = row,
			})
			return { Instance = row }
		end

		function Tab:CreateButton(o)
			o = o or {}
			local row = baseRow(38)
			local btn = create("TextButton", {
				Text = o.Name or o.name or "Button", Font = Theme.Font, TextSize = 13, TextColor3 = Theme.Text,
				BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = row,
			})
			btn.MouseEnter:Connect(function() tween(row, { BackgroundColor3 = Theme.SurfaceAlt }, 0.12) end)
			btn.MouseLeave:Connect(function() tween(row, { BackgroundColor3 = Theme.Surface }, 0.12) end)
			btn.MouseButton1Click:Connect(function() if o.Callback then task.spawn(o.Callback) end end)
			return { Instance = row }
		end

		function Tab:CreateToggle(o)
			o = o or {}
			local state = o.CurrentValue or o.Default or false
			registerFlag(o.Flag, state)
			local row = baseRow(38)
			create("TextLabel", {
				Text = o.Name or o.name or "Toggle", Font = Theme.Font, TextSize = 13, TextColor3 = Theme.Text,
				BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
				Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -60, 1, 0), Parent = row,
			})
			local switch = create("Frame", {
				Size = UDim2.fromOffset(36, 20), Position = UDim2.new(1, -48, 0.5, -10),
				BackgroundColor3 = state and Theme.Accent or Theme.SurfaceAlt, Parent = row,
			}, { corner(10) })
			local knob = create("Frame", {
				Size = UDim2.fromOffset(16, 16),
				Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
				BackgroundColor3 = Color3.new(1, 1, 1), Parent = switch,
			}, { corner(8) })
			local click = create("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = row })

			local Toggle = {}
			function Toggle:Set(value)
				state = value
				registerFlag(o.Flag, state)
				tween(switch, { BackgroundColor3 = state and Theme.Accent or Theme.SurfaceAlt }, 0.15)
				tween(knob, { Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8) }, 0.15)
				if o.Callback then task.spawn(o.Callback, state) end
			end
			click.MouseButton1Click:Connect(function() Toggle:Set(not state) end)
			Window._Elements[o.Flag or (name .. "_" .. (o.Name or ""))] = Toggle
			return Toggle
		end

		function Tab:CreateSlider(o)
			o = o or {}
			local min, max = o.Range and o.Range[1] or 0, o.Range and o.Range[2] or 100
			local value = o.CurrentValue or o.Default or min
			local increment = o.Increment or 1
			registerFlag(o.Flag, value)

			local row = baseRow(46)
			create("TextLabel", {
				Text = o.Name or o.name or "Slider", Font = Theme.Font, TextSize = 13, TextColor3 = Theme.Text,
				BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
				Position = UDim2.new(0, 12, 0, 6), Size = UDim2.new(1, -70, 0, 16), Parent = row,
			})
			local valueLabel = create("TextLabel", {
				Text = tostring(value), Font = Theme.Font, TextSize = 12, TextColor3 = Theme.SubText,
				BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Right,
				Position = UDim2.new(1, -60, 0, 6), Size = UDim2.new(0, 48, 0, 16), Parent = row,
			})
			local track = create("Frame", {
				BackgroundColor3 = Theme.SurfaceAlt, Position = UDim2.new(0, 12, 1, -14), Size = UDim2.new(1, -24, 0, 6), Parent = row,
			}, { corner(3) })
			local function pct(v) return (v - min) / (max - min) end
			local fill = create("Frame", { BackgroundColor3 = Theme.Accent, Size = UDim2.new(pct(value), 0, 1, 0), Parent = track }, { corner(3) })

			local dragging = false
			local Slider = {}
			function Slider:Set(v)
				v = math.clamp(v, min, max)
				v = math.floor(v / increment + 0.5) * increment
				value = v
				registerFlag(o.Flag, v)
				valueLabel.Text = tostring(v)
				tween(fill, { Size = UDim2.new(pct(v), 0, 1, 0) }, 0.08)
				if o.Callback then task.spawn(o.Callback, v) end
			end
			local function updateFromInput(input)
				local relative = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
				Slider:Set(min + relative * (max - min))
			end
			track.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true; updateFromInput(input)
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					updateFromInput(input)
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
			end)
			return Slider
		end

		function Tab:CreateDropdown(o)
			o = o or {}
			local options = o.Options or {}
			local selected = o.CurrentOption or options[1]
			registerFlag(o.Flag, selected)
			local open = false

			local row = baseRow(38)
			create("TextLabel", {
				Text = o.Name or o.name or "Dropdown", Font = Theme.Font, TextSize = 13, TextColor3 = Theme.Text,
				BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
				Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(0.5, 0, 1, 0), Parent = row,
			})
			local selectedLabel = create("TextLabel", {
				Text = tostring(selected or ""), Font = Theme.Font, TextSize = 12, TextColor3 = Theme.SubText,
				BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Right,
				Position = UDim2.new(0.5, -30, 0, 0), Size = UDim2.new(0.5, 20, 1, 0), Parent = row,
			})
			local click = create("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = row })
			local list = create("Frame", {
				BackgroundColor3 = Theme.SurfaceAlt, Size = UDim2.new(1, 0, 0, 0), ClipsDescendants = true,
				Position = UDim2.new(0, 0, 1, 4), Parent = row,
			}, { corner(6), create("UIListLayout", { Padding = UDim.new(0, 2) }), padding(4) })
			list.ZIndex = 5

			local Dropdown = {}
			local function rebuild()
				for _, c in ipairs(list:GetChildren()) do
					if c:IsA("TextButton") then c:Destroy() end
				end
				for _, opt in ipairs(options) do
					local optBtn = create("TextButton", {
						Text = tostring(opt), Font = Theme.Font, TextSize = 12, TextColor3 = Theme.Text,
						BackgroundColor3 = Theme.Surface, Size = UDim2.new(1, 0, 0, 26), Parent = list,
					}, { corner(4) })
					optBtn.MouseButton1Click:Connect(function()
						Dropdown:Set(opt); open = false
						tween(list, { Size = UDim2.new(1, 0, 0, 0) }, 0.12)
					end)
				end
			end
			function Dropdown:Set(opt)
				selected = opt; registerFlag(o.Flag, opt); selectedLabel.Text = tostring(opt)
				if o.Callback then task.spawn(o.Callback, opt) end
			end
			function Dropdown:Refresh(newOptions) options = newOptions; rebuild() end
			rebuild()
			click.MouseButton1Click:Connect(function()
				open = not open
				local h = open and (#options * 28 + 8) or 0
				tween(list, { Size = UDim2.new(1, 0, 0, h) }, 0.15)
			end)
			return Dropdown
		end

		function Tab:CreateColorPicker(o)
			o = o or {}
			local color = o.Default or Color3.fromRGB(255, 255, 255)
			registerFlag(o.Flag, { color.R, color.G, color.B })
			local row = baseRow(38)
			create("TextLabel", {
				Text = o.Name or o.name or "Color", Font = Theme.Font, TextSize = 13, TextColor3 = Theme.Text,
				BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
				Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -60, 1, 0), Parent = row,
			})
			local swatch = create("TextButton", {
				Text = "", BackgroundColor3 = color, Size = UDim2.fromOffset(28, 20),
				Position = UDim2.new(1, -40, 0.5, -10), Parent = row,
			}, { corner(5), stroke(Theme.Stroke, 1) })
			local panel = create("Frame", {
				BackgroundColor3 = Theme.SurfaceAlt, Size = UDim2.new(1, 0, 0, 0), ClipsDescendants = true,
				Position = UDim2.new(0, 0, 1, 4), Parent = row,
			}, { corner(6), padding(8), create("UIListLayout", { Padding = UDim.new(0, 6) }) })
			panel.ZIndex = 5

			local ColorPicker = { Value = color }
			local open = false
			local function makeChannel(labelText, initial, onChange)
				local wrap = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 16), Parent = panel })
				create("TextLabel", {
					Text = labelText, Font = Theme.Font, TextSize = 11, TextColor3 = Theme.SubText,
					BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
					Size = UDim2.new(0, 20, 1, 0), Parent = wrap,
				})
				local track = create("Frame", {
					BackgroundColor3 = Theme.Surface, Position = UDim2.new(0, 24, 0, 5), Size = UDim2.new(1, -24, 0, 6), Parent = wrap,
				}, { corner(3) })
				local fill = create("Frame", { BackgroundColor3 = Theme.Accent, Size = UDim2.new(initial / 255, 0, 1, 0), Parent = track }, { corner(3) })
				local dragging = false
				local function set(v)
					v = math.clamp(v, 0, 255); fill.Size = UDim2.new(v / 255, 0, 1, 0); onChange(v)
				end
				track.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						dragging = true; set((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X * 255)
					end
				end)
				UserInputService.InputChanged:Connect(function(input)
					if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
						set((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X * 255)
					end
				end)
				UserInputService.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
				end)
			end
			local r, g, b = color.R * 255, color.G * 255, color.B * 255
			local function refresh()
				local c = Color3.fromRGB(r, g, b)
				ColorPicker.Value = c; swatch.BackgroundColor3 = c
				registerFlag(o.Flag, { c.R, c.G, c.B })
				if o.Callback then task.spawn(o.Callback, c) end
			end
			makeChannel("R", r, function(v) r = v; refresh() end)
			makeChannel("G", g, function(v) g = v; refresh() end)
			makeChannel("B", b, function(v) b = v; refresh() end)
			swatch.MouseButton1Click:Connect(function()
				open = not open
				tween(panel, { Size = UDim2.new(1, 0, 0, open and 76 or 0) }, 0.15)
			end)
			function ColorPicker:Set(c) r, g, b = c.R * 255, c.G * 255, c.B * 255; refresh() end
			return ColorPicker
		end

		function Tab:CreateInput(o)
			o = o or {}
			registerFlag(o.Flag, o.Default or "")
			local row = baseRow(38)
			create("TextLabel", {
				Text = o.Name or o.name or "Input", Font = Theme.Font, TextSize = 13, TextColor3 = Theme.Text,
				BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
				Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(0.45, 0, 1, 0), Parent = row,
			})
			local box = create("TextBox", {
				Text = o.Default or "", PlaceholderText = o.PlaceholderText or "", Font = Theme.Font, TextSize = 12,
				TextColor3 = Theme.Text, BackgroundColor3 = Theme.SurfaceAlt, ClearTextOnFocus = false,
				Position = UDim2.new(0.45, 0, 0.5, -13), Size = UDim2.new(0.55, -12, 0, 26), Parent = row,
			}, { corner(5), padding(6) })

			local Input = {}
			function Input:Set(t) box.Text = t; registerFlag(o.Flag, t) end
			box.FocusLost:Connect(function(enterPressed)
				registerFlag(o.Flag, box.Text)
				if o.Callback and (enterPressed or o.RunOnFocusLost ~= false) then task.spawn(o.Callback, box.Text) end
			end)
			return Input
		end

		function Tab:CreateKeybind(o)
			o = o or {}
			local bound = o.Default or Enum.KeyCode.Unknown
			registerFlag(o.Flag, bound.Name)
			local listening = false
			local row = baseRow(38)
			create("TextLabel", {
				Text = o.Name or o.name or "Keybind", Font = Theme.Font, TextSize = 13, TextColor3 = Theme.Text,
				BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
				Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -110, 1, 0), Parent = row,
			})
			local keyBtn = create("TextButton", {
				Text = bound.Name, Font = Theme.Font, TextSize = 12, TextColor3 = Theme.SubText,
				BackgroundColor3 = Theme.SurfaceAlt, Size = UDim2.fromOffset(84, 26), Position = UDim2.new(1, -96, 0.5, -13), Parent = row,
			}, { corner(5) })

			local Keybind = {}
			keyBtn.MouseButton1Click:Connect(function()
				listening = true
				keyBtn.Text = "..."
			end)
			UserInputService.InputBegan:Connect(function(input, gameProcessed)
				if listening and input.UserInputType == Enum.UserInputType.Keyboard then
					bound = input.KeyCode
					keyBtn.Text = bound.Name
					registerFlag(o.Flag, bound.Name)
					listening = false
				elseif not listening and not gameProcessed and input.KeyCode == bound and o.Callback then
					task.spawn(o.Callback)
				end
			end)
			function Keybind:Set(keyCode) bound = keyCode; keyBtn.Text = keyCode.Name; registerFlag(o.Flag, keyCode.Name) end
			return Keybind
		end

		function Tab:CreateLabel(text)
			local row = baseRow(30)
			row.BackgroundTransparency = 1
			create("TextLabel", {
				Text = text or "", Font = Theme.Font, TextSize = 12, TextColor3 = Theme.SubText,
				BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 1, 0), Parent = row,
			})
			return { Instance = row }
		end

		return Tab
	end

	function Window:SaveConfiguration()
		if cfgSaving.Enabled then
			saveConfig(cfgSaving.FolderName, cfgSaving.FileName)
		end
	end

	function Window:LoadConfiguration()
		if cfgSaving.Enabled then
			local saved = loadConfig(cfgSaving.FolderName, cfgSaving.FileName)
			for flag, value in pairs(saved) do
				Nova.Flags[flag] = value
				local element = Window._Elements[flag]
				if element and element.Set then
					pcall(element.Set, element, value)
				end
			end
		end
	end

	return Window
end

return Nova
